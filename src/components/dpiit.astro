  document.addEventListener("DOMContentLoaded", () => {
    const buttons = document.querySelectorAll(".category-btn");
    const startupsList = document.getElementById("categoryStartupsList");
    const heading = document.getElementById("categoryListHeading");
    const contentContainer = document.getElementById("categoryListContent");

    let currentActiveCategory = null;

    buttons.forEach(btn => {
      btn.addEventListener("click", () => {
        const categoryKey = btn.getAttribute("data-category");
        
        // If clicking the currently active button, toggle collapse
        if (currentActiveCategory === categoryKey) {
          startupsList.classList.add("hidden-category");
          btn.classList.remove("active-category");
          currentActiveCategory = null;
          return;
        }

        // Remove active class from all buttons
        buttons.forEach(b => b.classList.remove("active-category"));
        
        // Mark this button as active
        btn.classList.add("active-category");
        currentActiveCategory = categoryKey;

        // Fetch category data
        const catData = startupsByCategory[categoryKey];
        if (!catData) return;

        // Update heading
        heading.textContent = catData.displayName + " Uploaded Startups";

        // Generate columns
        const startups = catData.startups || [];
        
        if (startups.length === 0) {
          contentContainer.innerHTML = '<div class="col-12 text-center text-muted py-3">No startups in this category.</div>';
        } else {
          const colSize = Math.ceil(startups.length / 3);
          const cols = [
            startups.slice(0, colSize),
            startups.slice(colSize, colSize * 2),
            startups.slice(colSize * 2)
          ];

          let html = '';
          cols.forEach(col => {
            html += '<div class="col-md-4"><ul class="list-group list-group-flush bg-transparent" style="list-style: none; padding: 0;">';
            col.forEach(name => {
              html += `<li class="py-2 border-bottom border-light text-sm text-dark font-weight-normal"><i class="fa fa-rocket text-primary me-2" style="font-size: 11px;"></i>${name}</li>`;
            });
            html += '</ul></div>';
          });
          contentContainer.innerHTML = html;
        }

        // Show the list
        startupsList.classList.remove("hidden-category");
      });
    });
  });
</script>