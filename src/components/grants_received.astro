<script>
  function initGrantsTabSwitcher() {
    const tabLinks = document.querySelectorAll('#v-pills-tab a[href^="#"]');
    const tabPanes = document.querySelectorAll('#v-pills-tabContent .tab-pane');

    tabLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href');
        if (!targetId || targetId === '#') return;

        const targetPane = document.querySelector(targetId);
        if (!targetPane) return;

        tabLinks.forEach(l => l.classList.remove('active'));
        link.classList.add('active');

        tabPanes.forEach(pane => {
          pane.classList.remove('show', 'active');
        });

        targetPane.classList.add('show', 'active');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGrantsTabSwitcher);
  } else {
    initGrantsTabSwitcher();
  }
</script>
