<style>
  .puthulir-section {
    background: radial-gradient(circle at 50% 10%, rgba(124, 58, 237, 0.06) 0%, rgba(255, 255, 255, 1) 75%);
    min-height: 85vh;
    padding: 4rem 1rem;
    overflow: hidden;
  }

  /* Animated Header Badge */
  .header-badge-animated {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(236, 72, 153, 0.1));
    color: #7C3AED;
    border: 1px solid rgba(124, 58, 237, 0.2);
    padding: 8px 22px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.6px;
    display: inline-block;
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.08);
    animation: fadeInDown 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Shimmer Gradient Title */
  .title-shimmer {
    background: linear-gradient(90deg, #3B82F6 0%, #7C3AED 35%, #EC4899 70%, #3B82F6 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 5s linear infinite, fadeInDown 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
    opacity: 0;
  }

  @keyframes shine {
    to { background-position: 200% center; }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Timeline Container */
  .timeline-container {
    max-width: 820px;
    margin: 0 auto 3.5rem auto;
    position: relative;
  }

  /* Animated Vertical Line */
  .timeline-line {
    position: absolute;
    left: 45px;
    top: 35px;
    bottom: 35px;
    width: 3px;
    background: linear-gradient(to bottom, #6366F1, #8B5CF6, #EC4899);
    border-radius: 3px;
    z-index: 1;
    transform-origin: top;
    animation: growLine 1.4s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  @keyframes growLine {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  /* Animated Timeline Cards */
  .timeline-card-animated {
    position: relative;
    z-index: 2;
    background: #ffffff;
    border-radius: 18px;
    padding: 1.5rem 1.85rem;
    margin-bottom: 1.6rem;
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    gap: 1.35rem;
    opacity: 0;
    animation: fadeInUpCard 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, border-color 0.35s ease;
  }

  @keyframes fadeInUpCard {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .timeline-card-animated:hover {
    transform: translateY(-6px) scale(1.015);
    box-shadow: 0 16px 36px rgba(124, 58, 237, 0.15), 0 0 15px rgba(236, 72, 153, 0.1);
    border-color: rgba(124, 58, 237, 0.35);
  }

  /* Step Badge Number */
  .step-number-animated {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366F1 0%, #7C3AED 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
  }

  .timeline-card-animated:hover .step-number-animated {
    transform: rotate(360deg) scale(1.1);
    box-shadow: 0 8px 24px rgba(124, 58, 237, 0.5);
  }

  .timeline-content {
    flex: 1;
  }

  .event-title {
    font-size: 1.22rem;
    font-weight: 700;
    color: #1E293B;
    margin-bottom: 0.3rem;
    transition: color 0.3s ease;
  }

  .timeline-card-animated:hover .event-title {
    color: #7C3AED;
  }

  .event-date {
    font-size: 1.05rem;
    font-weight: 600;
    color: #7C3AED;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .event-date-badge {
    background: rgba(124, 58, 237, 0.08);
    padding: 5px 14px;
    border-radius: 10px;
    display: inline-block;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .timeline-card-animated:hover .event-date-badge {
    background: rgba(124, 58, 237, 0.16);
    transform: translateX(4px);
  }

  /* Grand Finale Special Card Glow */
  .finale-card {
    border: 2px solid transparent;
    background: linear-gradient(#ffffff, #ffffff) padding-box,
                linear-gradient(135deg, #EC4899, #8B5CF6, #3B82F6) border-box;
    box-shadow: 0 8px 25px rgba(236, 72, 153, 0.15);
  }

  .finale-badge {
    background: linear-gradient(135deg, rgba(236, 72, 153, 0.12), rgba(244, 63, 94, 0.15)) !important;
    color: #E11D48 !important;
    font-weight: 700;
  }

  .finale-step {
    background: linear-gradient(135deg, #EC4899 0%, #F43F5E 100%) !important;
    box-shadow: 0 6px 18px rgba(236, 72, 153, 0.4) !important;
  }

  /* Icon Bounce Effect */
  .animated-icon {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .timeline-card-animated:hover .animated-icon {
    animation: bounceIcon 0.6s cubic-bezier(0.36, 0.07, 0.19, 0.97) infinite alternate;
  }

  @keyframes bounceIcon {
    from { transform: translateY(0); }
    to { transform: translateY(-4px); }
  }

  /* ==================================================
     HIGH-IMPACT VOUCHER CARD & APPLY BUTTON
  ================================================== */
  .voucher-card {
    max-width: 820px;
    margin: 0 auto;
    background: linear-gradient(135deg, #ffffff 0%, #FAF5FF 100%);
    border-radius: 24px;
    border: 2px solid rgba(124, 58, 237, 0.22);
    box-shadow: 0 16px 40px rgba(124, 58, 237, 0.1), 0 0 20px rgba(236, 72, 153, 0.05);
    padding: 2.5rem 2rem;
    text-align: center;
    position: relative;
    animation: fadeInUpCard 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.1s forwards;
    opacity: 0;
  }

  .voucher-top-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(124, 58, 237, 0.08);
    color: #7C3AED;
    border: 1px solid rgba(124, 58, 237, 0.2);
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .voucher-code-container {
    margin-bottom: 1.25rem;
  }

  .voucher-code-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border: 2px dashed #7C3AED;
    border-radius: 14px;
    padding: 0.7rem 1.8rem;
    box-shadow: 0 6px 18px rgba(124, 58, 237, 0.12);
    transition: transform 0.3s ease;
  }

  .voucher-code-badge:hover {
    transform: scale(1.04);
  }

  .voucher-code-text {
    font-family: SFMono-Regular, Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    background: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .voucher-eligibility-text {
    font-size: 1.1rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }

  .highlight-school-type {
    color: #7C3AED;
    font-weight: 700;
  }

  /* High-Impact Apply Button with Pulse Ring */
  .btn-apply-pulse {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: linear-gradient(135deg, #7C3AED 0%, #EC4899 50%, #F43F5E 100%);
    color: #ffffff !important;
    font-size: 1.18rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 0.95rem 3.8rem;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 10px 28px rgba(124, 58, 237, 0.35);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
  }

  .btn-apply-pulse:hover {
    transform: translateY(-4px) scale(1.04);
    box-shadow: 0 16px 36px rgba(236, 72, 153, 0.45);
    color: #ffffff !important;
  }

  .btn-arrow-icon {
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }

  .btn-apply-pulse:hover .btn-arrow-icon {
    transform: translateX(6px);
  }

  /* Pulse Glow Ring */
  .pulse-container {
    position: relative;
    display: inline-block;
  }

  .pulse-container::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 50px;
    background: rgba(124, 58, 237, 0.35);
    z-index: -1;
    animation: pulseGlow 2.5s infinite;
  }

  @keyframes pulseGlow {
    0% { transform: scale(0.96); opacity: 0.8; }
    70% { transform: scale(1.15); opacity: 0; }
    100% { transform: scale(0.96); opacity: 0; }
  }

  /* Responsive Styling */
  @media (max-width: 768px) {
    .timeline-line {
      left: 28px;
    }
    .step-number-animated {
      width: 44px;
      height: 44px;
      min-width: 44px;
      font-size: 1.1rem;
    }
    .timeline-card-animated {
      padding: 1.25rem 1.1rem;
      gap: 0.9rem;
    }
    .event-title {
      font-size: 1.05rem;
    }
    .event-date {
      font-size: 0.95rem;
    }
    .voucher-card {
      padding: 1.8rem 1.2rem;
    }
    .voucher-code-text {
      font-size: 1.35rem;
    }
    .voucher-eligibility-text {
      font-size: 0.98rem;
    }
    .btn-apply-pulse {
      width: 100%;
      padding: 0.9rem 1.5rem;
    }
  }
</style>

<section class="puthulir-section d-flex align-items-center">
  <div class="container py-3">

    <!-- HEADER SECTION WITH FADE ANIMATION -->
    <div class="text-center mb-5">
      <div class="mb-3">
        <span class="header-badge-animated">✨ CED ANNA UNIVERSITY</span>
      </div>
      <h1 class="display-3 fw-extrabold title-shimmer mb-0">
        PuThulir 3.0
      </h1>
    </div>

    <!-- TIMELINE CARDS CONTAINER -->
    <div class="timeline-container">
      <div class="timeline-line"></div>

      <!-- ITEM 1 -->
      <div class="timeline-card-animated" style="--delay: 0.2s;">
        <div class="step-number-animated">1</div>
        <div class="timeline-content">
          <div class="event-title">Last Date for Registration</div>
          <div class="event-date">
            <span class="event-date-badge"><span class="animated-icon">📅</span> 15th October 2026</span>
          </div>
        </div>
      </div>

      <!-- ITEM 2 -->
      <div class="timeline-card-animated" style="--delay: 0.35s;">
        <div class="step-number-animated">2</div>
        <div class="timeline-content">
          <div class="event-title">Online Bootcamp</div>
          <div class="event-date">
            <span class="event-date-badge"><span class="animated-icon">💻</span> 26th to 28th October 2026</span>
          </div>
        </div>
      </div>

      <!-- ITEM 3 -->
      <div class="timeline-card-animated" style="--delay: 0.5s;">
        <div class="step-number-animated">3</div>
        <div class="timeline-content">
          <div class="event-title">AI tools Training</div>
          <div class="event-date">
            <span class="event-date-badge"><span class="animated-icon">🤖</span> 31st October 2026</span>
          </div>
        </div>
      </div>

      <!-- ITEM 4 -->
      <div class="timeline-card-animated" style="--delay: 0.65s;">
        <div class="step-number-animated">4</div>
        <div class="timeline-content">
          <div class="event-title">Last Date for Submission of PPT</div>
          <div class="event-date">
            <span class="event-date-badge"><span class="animated-icon">📤</span> 5th November 2026</span>
          </div>
        </div>
      </div>

      <!-- ITEM 5 -->
      <div class="timeline-card-animated" style="--delay: 0.8s;">
        <div class="step-number-animated">5</div>
        <div class="timeline-content">
          <div class="event-title">Regional Level Presentation</div>
          <div class="event-date">
            <span class="event-date-badge"><span class="animated-icon">🏫</span> 14th November 2026</span>
          </div>
        </div>
      </div>

      <!-- ITEM 6 (GRAND FINALE WITH SPECIAL EFFECTS) -->
      <div class="timeline-card-animated finale-card" style="--delay: 0.95s;">
        <div class="step-number-animated finale-step">6</div>
        <div class="timeline-content">
          <div class="event-title text-primary">Grand Finale at Anna University Chennai</div>
          <div class="event-date">
            <span class="event-date-badge finale-badge"><span class="animated-icon">🏆</span> 29th December 2026</span>
          </div>
        </div>
      </div>

    </div>

    <!-- HIGH-IMPACT VOUCHER CARD & APPLY BUTTON -->
    <div class="voucher-card">
      <div class="voucher-top-tag">
        <span>🎟️ SPECIAL SCHOOL FEE WAIVER</span>
      </div>

      <div class="voucher-code-container">
        <div class="voucher-code-badge">
          <span>🏷️</span>
          <span class="voucher-code-text">PUTHGOV</span>
        </div>
      </div>

      <div class="voucher-eligibility-text">
        The coupon code is applicable only for <span class="highlight-school-type">Government Schools</span> and <span class="highlight-school-type">Government-Aided Schools</span>.
      </div>

      <div class="pulse-container">
        <a href="https://www.eventzgo.com/events/j5750eqm8wzyzwg3z5bvc2xbes8e8bdq?utm_source=chatgpt.com" 
           target="_blank" 
           rel="noopener noreferrer" 
           class="btn-apply-pulse">
          <span>APPLY NOW</span>
          <span class="btn-arrow-icon">➔</span>
        </a>
      </div>
    </div>

  </div>
</section>
