      <!-- Navigation indicators -->
      <div class="carousel-navigation">
        <div class="carousel-dots" id="carouselDotsContainer"></div>
      </div>
    </div>

  </section>

  <!-- Horizontal Stats Footer Bar -->
  <div class="stats-glass-card">
    <div class="stat-item">
      <div class="stat-icon-wrapper stat-icon-rocket">
        <i class="fa fa-rocket"></i>
      </div>
      <div class="stat-info">
        <h3>150+</h3>
        <p>Startups Supported</p>
      </div>
    </div>
    <div class="stat-item">
      <div class="stat-icon-wrapper stat-icon-users">
        <i class="fa fa-users"></i>
      </div>
      <div class="stat-info">
        <h3>5000+</h3>
        <p>Students Engaged</p>
      </div>
    </div>
    <div class="stat-item">
      <div class="stat-icon-wrapper stat-icon-calendar">
        <i class="fa fa-calendar"></i>
      </div>
      <div class="stat-info">
        <h3>100+</h3>
        <p>Events Conducted</p>
      </div>
    </div>
    <div class="stat-item">
      <div class="stat-icon-wrapper stat-icon-trophy">
        <i class="fa fa-trophy"></i>
      </div>
      <div class="stat-info">
        <h3>25+</h3>
        <p>Partners & Mentors</p>
      </div>
    </div>
  </div>

</div>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const slides = document.querySelectorAll(".ced-slide-card");
  const dotsContainer = document.getElementById("carouselDotsContainer");
  const prevBtn = document.getElementById("carouselPrevBtn");
  const nextBtn = document.getElementById("carouselNextBtn");

  if (slides.length === 0) return;

  let currentIdx = 0;
  const totalSlides = slides.length;

  // Detect wide landscape images dynamically to only apply panning to images that would otherwise crop
  slides.forEach((slide) => {
    const imgDiv = slide.querySelector(".slide-img");
    if (!imgDiv) return;
    const bgImg = window.getComputedStyle(imgDiv).backgroundImage;
    const urlMatch = bgImg.match(/url\(['"]?(.*?)['"]?\)/);
    if (urlMatch && urlMatch[1]) {
      const imgUrl = urlMatch[1];
      const tempImg = new Image();
      tempImg.onload = function() {
        const aspect = tempImg.naturalWidth / tempImg.naturalHeight;
        if (aspect > 0.9) {
          imgDiv.classList.add("is-wider");
        }
      };
      tempImg.src = imgUrl;
    }
  });

  // Create Pagination Dots
  for (let i = 0; i < totalSlides; i++) {
    const dot = document.createElement("span");
    dot.className = `carousel-dot ${i === 0 ? "active" : ""}`;
    dot.addEventListener("click", () => {
      currentIdx = i;
      updateCarousel();
    });
    dotsContainer.appendChild(dot);
  }

  const dots = document.querySelectorAll(".carousel-dot");

  function updateCarousel() {
    slides.forEach((slide, idx) => {
      // Clear class lists
      slide.className = "ced-slide-card";

      // Calculate relative index wrapped to [-half, half] range for perfect bilateral symmetry
      let diff = idx - currentIdx;
      const half = Math.floor(totalSlides / 2);
      while (diff <= -half) diff += totalSlides;
      while (diff > (totalSlides - 1) - half) diff -= totalSlides;

      if (diff === 0) {
        slide.classList.add("ced-active");
      } else if (diff === 1) {
        slide.classList.add("ced-next");
      } else if (diff === 2) {
        slide.classList.add("ced-far-next");
      } else if (diff >= 3) {
        slide.classList.add("ced-far-far-next");
      } else if (diff === -1) {
        slide.classList.add("ced-prev");
      } else if (diff === -2) {
        slide.classList.add("ced-far-prev");
      } else if (diff <= -3) {
        slide.classList.add("ced-far-far-prev");
      } else {
        slide.classList.add("ced-hide");
      }
    });

    // Update dots active state
    dots.forEach((dot, idx) => {
      if (idx === currentIdx) {
        dot.classList.add("active");
      } else {
        dot.classList.remove("active");
      }
    });


  }

  // Next / Prev Actions
  prevBtn.addEventListener("click", () => {
    currentIdx = (currentIdx - 1 + totalSlides) % totalSlides;
    updateCarousel();
    resetAutoPlay();
  });

  nextBtn.addEventListener("click", () => {
    currentIdx = (currentIdx + 1) % totalSlides;
    updateCarousel();
    resetAutoPlay();
  });

  // Auto-play feature (aligned to 6.5s to allow active slide image to complete panning)
  let autoPlayInterval = setInterval(() => {
    currentIdx = (currentIdx + 1) % totalSlides;
    updateCarousel();
  }, 6500);

  function resetAutoPlay() {
    clearInterval(autoPlayInterval);
    autoPlayInterval = setInterval(() => {
      currentIdx = (currentIdx + 1) % totalSlides;
      updateCarousel();
    }, 6500);
  }

  // Click on cards to activate them
  slides.forEach((slide, idx) => {
    slide.addEventListener("click", () => {
      currentIdx = idx;
      updateCarousel();
      resetAutoPlay();
    });
  });

  // Canvas 3D Tech Background Animation
  const canvas = document.getElementById("techBgCanvas");
  if (canvas) {
    const ctx = canvas.getContext("2d");
    let width = canvas.offsetWidth;
    let height = canvas.offsetHeight;
    canvas.width = width;
    canvas.height = height;

    window.addEventListener("resize", () => {
      width = canvas.offsetWidth;
      height = canvas.offsetHeight;
      canvas.width = width;
      canvas.height = height;
    });

    const globes = [];
    const focalLength = 350;
    
    let mouseX = 0;
    let mouseY = 0;

    document.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      mouseX = e.clientX - cx;
      mouseY = e.clientY - cy;
    });

    // Configuration for three distinct moving spheres (representing progressive innovation stages)
    const globeConfigs = [
      { y: -120, z: 20, radius: 110, speed: 0.85, colorTheme: 'pink' },
      { y: 130, z: -100, radius: 85, speed: 0.6, colorTheme: 'orange' },
      { y: 20, z: 120, radius: 65, speed: 1.1, colorTheme: 'pink' }
    ];

    globeConfigs.forEach((config, gIdx) => {
      const particles = [];
      const numLocalParticles = 30;
      
      for (let i = 0; i < numLocalParticles; i++) {
        const u = Math.random();
        const v = Math.random();
        const theta = u * 2.0 * Math.PI;
        const phi = Math.acos(2.0 * v - 1.0);

        particles.push({
          lx: config.radius * Math.sin(phi) * Math.cos(theta),
          ly: config.radius * Math.sin(phi) * Math.sin(theta),
          lz: config.radius * Math.cos(phi),
          size: Math.random() * 1.5 + 1.0,
          color: config.colorTheme === 'pink' ? "rgba(211, 27, 138, opacity)" : "rgba(254, 127, 75, opacity)"
        });
      }

      globes.push({
        x: (Math.random() - 0.5) * 800 - 300, // Staggered starting X position
        y: config.y,
        z: config.z,
        radius: config.radius,
        speed: config.speed,
        particles: particles,
        rotX: Math.random() * Math.PI,
        rotY: Math.random() * Math.PI,
        rotSpeedX: 0.001 + Math.random() * 0.002,
        rotSpeedY: 0.002 + Math.random() * 0.003
      });
    });

    function rotate3D(point, rx, ry) {
      const cosY = Math.cos(ry);
      const sinY = Math.sin(ry);
      let x1 = point.x * cosY - point.z * sinY;
      let z1 = point.z * cosY + point.x * sinY;
      
      const cosX = Math.cos(rx);
      const sinX = Math.sin(rx);
      let y2 = point.y * cosX - z1 * sinX;
      let z2 = z1 * cosX + point.y * sinX;

      return { x: x1, y: y2, z: z2 };
    }

    function animate() {
      ctx.clearRect(0, 0, width, height);

      // Mouse interactive tilt addition
      const mouseTiltX = mouseY * 0.0000015;
      const mouseTiltY = mouseX * 0.0000015;

      const centerX = width / 2;
      const centerY = height / 2;

      globes.forEach(g => {
        // Translate from left to right (X goes from -width/2 to width/2 in projected coordinates)
        const halfW = width / 2;
        g.x += g.speed;
        
        // Wrap around when exiting screen boundaries
        const limit = halfW + g.radius + 100;
        if (g.x > limit) {
          g.x = -limit;
        }

        // Local rotation spin
        g.rotX += g.rotSpeedX + mouseTiltX;
        g.rotY += g.rotSpeedY + mouseTiltY;

        // Project local coordinates to screen space
        const projected = g.particles.map(p => {
          const rotPoint = rotate3D({ x: p.lx, y: p.ly, z: p.lz }, g.rotX, g.rotY);
          const gx = g.x + rotPoint.x;
          const gy = g.y + rotPoint.y;
          const gz = g.z + rotPoint.z;

          const scale = focalLength / (focalLength + gz);
          return {
            x: gx * scale + centerX,
            y: gy * scale + centerY,
            scale: scale,
            z: gz,
            size: p.size,
            color: p.color
          };
        });

        // Draw connections for this globe
        const numP = g.particles.length;
        for (let i = 0; i < numP; i++) {
          let connections = 0;
          for (let j = i + 1; j < numP; j++) {
            const p1 = g.particles[i];
            const p2 = g.particles[j];
            
            const dx = p1.lx - p2.lx;
            const dy = p1.ly - p2.ly;
            const dz = p1.lz - p2.lz;
            const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

            if (dist < g.radius * 0.75 && connections < 3) {
              const proj1 = projected[i];
              const proj2 = projected[j];

              const avgZ = (proj1.z + proj2.z) / 2;
              const zFade = Math.max(0.1, Math.min(0.7, (focalLength - avgZ) / (focalLength * 1.5)));
              const alpha = (1 - dist / (g.radius * 0.75)) * 0.14 * zFade;

              ctx.strokeStyle = `rgba(211, 27, 138, ${alpha})`;
              ctx.lineWidth = 0.5 * proj1.scale;
              ctx.beginPath();
              ctx.moveTo(proj1.x, proj1.y);
              ctx.lineTo(proj2.x, proj2.y);
              ctx.stroke();
              connections++;
            }
          }
        }

        // Draw particles for this globe
        projected.forEach(p => {
          const opacity = Math.max(0.08, Math.min(0.8, (focalLength - p.z) / (focalLength * 1.5)));
          ctx.fillStyle = p.color.replace("opacity", opacity);
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size * p.scale, 0, Math.PI * 2);
          ctx.fill();
        });
      });

      requestAnimationFrame(animate);
    }
    animate();
  }

  // Typing Effect for Quote Ribbon (Non-Stop loop)
  const quoteEl = document.querySelector('.tn-quote-text');
  if (quoteEl) {
    const text = quoteEl.getAttribute('data-text') || '';
    quoteEl.innerHTML = '<span class="typing-text"></span><span class="typing-cursor">|</span>';
    const typingTextEl = quoteEl.querySelector('.typing-text');
    let idx = 0;
    
    function handleType() {
      if (idx <= text.length) {
        typingTextEl.textContent = text.slice(0, idx);
        idx++;
        setTimeout(handleType, 45 + Math.random() * 25);
      } else {
        idx = 0;
        setTimeout(handleType, 1000); // 1s pause when complete, then start typing immediately again
      }
    }
    
    setTimeout(handleType, 500);
  }

  // Initialize
  updateCarousel();
});
</script>
