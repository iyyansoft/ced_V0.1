---

<section class="video-wrapper-section">

  <!-- TOP CONTENT -->

  <div class="top-content">

    <p class="small-title">
      Testimonials
    </p>

    <h1>
      What Our <span>Users</span> Are Saying
    </h1>

  </div>

  <!-- HEADING -->

  <h3 class="video-heading">
    Video Stories
  </h3>

  <!-- VIDEO SCROLL -->

  <div class="video-scroll">

    {
      videos.map((video) => (

        <div class="video-card">

          <video
            controls
            muted
            playsinline
            preload="metadata"
            poster={video.thumbnail}
          >

            <source
              src={video.url}
              type="video/mp4"
            />

          </video>

          <div class="video-content">

            <h2>{video.title}</h2>

            <p>{video.name}</p>

          </div>

        </div>

      ))
    }

  </div>

</section>

<script>

  const videos = document.querySelectorAll("video");

  const cards = document.querySelectorAll(".video-card");

  videos.forEach((video, index) => {

    video.addEventListener("play", () => {

      // PAUSE OTHER VIDEOS

      videos.forEach((otherVideo, otherIndex) => {

        if (otherVideo !== video) {

          otherVideo.pause();

          cards[otherIndex].classList.remove("active");

        }

      });

      // ACTIVE CARD

      cards[index].classList.add("active");

    });

    // REMOVE ACTIVE CARD

    video.addEventListener("pause", () => {

      cards[index].classList.remove("active");

    });

  });

</script>

<style>

  .video-wrapper-section {

    width: 100%;

    padding: 90px 0;

    background: linear-gradient(
      135deg,
      #f8fafc 0%,
      #eef2ff 50%,
      #f1f5f9 100%
    );

    overflow: hidden;
  }

  /* TOP CONTENT */

  .top-content {

    text-align: center;

    margin-bottom: 60px;

    padding: 0 20px;
  }

  .small-title {

    font-size: 20px;

    color: #94a3b8;

    margin-bottom: 14px;
  }

  .top-content h1 {

    font-size: 60px;

    font-weight: 800;

    line-height: 1.1;

    color: #0f172a;
  }

  .top-content h1 span {

    color: rgb(171, 23, 133);
  }

  /* HEADING */

  .video-heading {

    text-align: center;

    font-size: 32px;

    margin-bottom: 40px;

    color: #0f172a;
  }

  /* VIDEO SCROLL */

  .video-scroll {

    display: flex;

    align-items: center;

    gap: 24px;

    overflow-x: auto;

    overflow-y: hidden;

    padding: 20px 40px;

    scroll-behavior: smooth;

    scrollbar-width: none;

    -webkit-overflow-scrolling: touch;
  }

  .video-scroll::-webkit-scrollbar {

    display: none;
  }

  /* VIDEO CARD */

  .video-card {

    flex: 0 0 calc((100% - 96px) / 4.5);

    max-width: 320px;

    min-width: 260px;

    height: 520px;

    border-radius: 30px;

    overflow: hidden;

    background: rgba(255,255,255,0.96);

    border: 1px solid rgba(255,255,255,0.5);

    box-shadow:
      0 12px 35px rgba(0,0,0,0.10);

    transition: all 0.4s ease;

    transform: scale(0.97);
  }

  /* ACTIVE CARD */

  .video-card.active {

    transform: scale(1.02);

    box-shadow:
      0 25px 60px rgba(0,0,0,0.22);

    z-index: 99;
  }

  /* VIDEO */

  .video-card video {

    width: 100%;

    height: 80%;

    object-fit: contain;

    background: black;

    display: block;
  }

  /* CONTENT */

  .video-content {

    height: 20%;

    padding: 18px;

    text-align: center;

    display: flex;

    flex-direction: column;

    justify-content: center;

    background: white;
  }

  .video-content h2 {

    font-size: 22px;

    font-weight: 700;

    color: #0f172a;

    margin-bottom: 6px;
  }

  .video-content p {

    font-size: 16px;

    color: #64748b;
  }

  /* LAPTOP */

  @media (max-width: 1200px) {

    .video-card {

      flex: 0 0 calc((100% - 48px) / 3.5);

    }

  }

  /* TABLET */

  @media (max-width: 768px) {

    .video-wrapper-section {

      padding: 60px 0;
    }

    .top-content h1 {

      font-size: 40px;
    }

    .video-heading {

      font-size: 26px;
    }

    .video-scroll {

      padding: 20px 16px;

      gap: 18px;
    }

    .video-card {

      flex: 0 0 260px;

      height: 460px;
    }

  }

  /* MOBILE */

  @media (max-width: 480px) {

    .top-content h1 {

      font-size: 32px;
    }

    .video-heading {

      font-size: 22px;
    }

    .video-card {

      flex: 0 0 220px;

      height: 400px;
    }

    .video-content h2 {

      font-size: 20px;
    }

    .video-content p {

      font-size: 14px;
    }

  }

</style>